{
  "name": "@devframes/self-inspect",
  "type": "module",
  "version": "0.5.4",
  "description": "Inspect the devframe hub state — registered docks, RPC functions, shared state, auth tokens, and client scripts.",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/devframes/devframe#readme",
  "repository": {
    "directory": "packages/self-inspect",
    "type": "git",
    "url": "git+https://github.com/devframes/devframe.git"
  },
  "bugs": "https://github.com/devframes/devframe/issues",
  "keywords": [
    "devtools",
    "devframe",
    "inspect",
    "debug"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:node && pnpm run build:client",
    "build:node": "tsdown",
    "build:client": "vite build --config app/vite.config.ts",
    "watch": "tsdown --watch",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@devframes/hub": "workspace:*",
    "devframe": "workspace:*"
  },
  "devDependencies": {
    "@devframes/hub": "workspace:*",
    "@preact/preset-vite": "catalog:build",
    "devframe": "workspace:*",
    "preact": "catalog:frontend",
    "tsdown": "catalog:build",
    "vite": "catalog:build"
  }
}
